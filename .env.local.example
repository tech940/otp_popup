# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel: Project -> Settings -> Environment Variables.

# ── Twilio Verify (SMS OTP for the Instant Price unlock popup) ──
# Server-side only. Never prefix these with NEXT_PUBLIC_.
# Account SID — Twilio Console -> Account Info (starts with AC).
TWILIO_ACCOUNT_SID=
# Auth Token — Twilio Console -> Account Info. Mark as Sensitive in Vercel.
TWILIO_AUTH_TOKEN=
# Verify Service SID — Twilio Console -> Verify -> Services -> "AM Ford" (starts with VA).
TWILIO_VERIFY_SERVICE_SID=

# Extra browser origins allowed to call /api/send-otp and /api/verify-otp, comma-separated.
# The popup iframe calls its own origin, which is always allowed — usually leave blank.
ALLOWED_ORIGINS=

# ── Lead email ──
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# ── Supabase (lead storage) ──
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# ── Admin leads page ──
ADMIN_LEADS_SECRET=
